@model Brand

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center text-uppercase">
            Brand Details
        </div>

        <div class="card-body">
            <div class="row">

                <!-- Left Side -->
                <div class="col-md-8">

                    <div class="row mb-2">
                        <div class="col-md-4">
                            <strong class="text-uppercase">Id</strong>
                        </div>
                        <div class="col-md-8">
                            : @Model.Id
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-4">
                            <strong class="text-uppercase">Brand Name</strong>
                        </div>
                        <div class="col-md-8">
                            : @Model.Name
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <strong class="text-uppercase">Established Year</strong>
                        </div>
                        <div class="col-md-8">
                            : @Model.EstablishedYear
                        </div>
                    </div>

                </div>

                <!-- Right Side -->
                <div class="col-md-4 text-center">
                    <img src="@Model.BrandLogo"
                         class="img-fluid"
                         style="max-height:250px;"
                         alt="Brand Logo" />
                </div>

                <div class="row"> 
                    <div class="col-md-12 text-center"> 
                        <a asp-controller="Brand" asp-action="Index" class="btn btn-danger">Back</a> 
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>